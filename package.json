{
	"name": "react_app",
	"version": "0.1.0",
	"private": true,
	"dependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^13.5.0",
		"@types/jest": "^27.5.2",
		"@types/node": "^16.18.126",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"json-server": "^0.17.4",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-scripts": "5.0.1",
		"typescript": "^4.9.5",
		"web-vitals": "^2.1.4"
	},
	"scripts": {
		"start": "react-scripts start",
		"serve": "json-server --watch ./src/server/db/index.js --routes ./src/server/routes.json --port 3001",
		"save-json-api": "node ./src/server/scripts/save-json-api.js",
		"build": "react-scripts build && npm run save-json-api",
		"predeploy": "rm -rf build && npm run build",
		"deploy": "gh-pages -d build",
		"test": "react-scripts test",
		"eject": "react-scripts eject"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"homepage": "https://ziron02.github.io/react_app",
	"devDependencies": {
		"gh-pages": "^6.3.0",
		"node-fs": "^0.1.7"
	}
}
